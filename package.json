{
  "name": "releaselens",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "Release-aware regression triage with source-backed engineering briefs",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "dev": "node scripts/build.mjs && node --env-file-if-exists=.env src/server.ts",
    "start": "node --env-file-if-exists=.env src/server.ts",
    "test": "node --test tests/*.test.ts",
    "eval": "node scripts/evaluate.ts",
    "eval:rag": "node --env-file-if-exists=.env scripts/evaluate-rag.ts",
    "models:setup": "node --env-file-if-exists=.env scripts/local-models.mjs setup",
    "models:serve": "node --env-file-if-exists=.env scripts/local-models.mjs serve",
    "models:pull": "node --env-file-if-exists=.env scripts/local-models.mjs pull",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write src tests scripts public docs README.md package.json tsconfig.json .github",
    "check": "npm run typecheck && npm test && npm run eval && npm run build",
    "build:hosted": "node scripts/build-hosted.mjs",
    "dev:hosted": "node --env-file-if-exists=.env scripts/preview-hosted.ts",
    "db:generate": "drizzle-kit generate",
    "eval:hosted": "node --env-file-if-exists=.env scripts/evaluate-hosted.ts"
  },
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^24.19.2",
    "drizzle-kit": "^0.31.11",
    "esbuild": "^0.28.2",
    "prettier": "^3.9.10",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "@langchain/core": "^1.3.2",
    "@langchain/ollama": "^1.3.0",
    "@langchain/openai": "^1.8.0",
    "@langchain/textsplitters": "^1.0.2",
    "drizzle-orm": "^0.45.4",
    "zod": "^4.6.7"
  }
}
